# Copy this file to ".env" and edit the values. NEVER commit ".env".
PORT=5000
NODE_ENV=development

# Origin of the React app (Vite dev server). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# Demonstration administrator (ACADEMIC USE ONLY).
# The password is hashed with bcrypt when the server starts.
# Choose your own value (at least 8 characters). Do not reuse a real password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Admin session length in hours, and max photo size in MB
SESSION_HOURS=8
MAX_UPLOAD_MB=5
